{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gotify Notifier",
  "version": "0.4.0",
  "identifier": "com.gotify.notifier",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "🔔 Gotify 通知",
        "width": 380,
        "height": 600,
        "minWidth": 260,
        "minHeight": 200,
        "resizable": true,
        "maximizable": false,
        "fullscreen": false,
        "center": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "alwaysOnTop": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}