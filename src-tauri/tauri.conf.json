{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gotify Notifier",
  "version": "0.5.0",
  "identifier": "com.gotify.notifier",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Gotify",
        "width": 340,
        "height": 240,
        "minWidth": 240,
        "minHeight": 140,
        "resizable": true,
        "maximizable": false,
        "fullscreen": false,
        "center": false,
        "decorations": false,
        "alwaysOnTop": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
